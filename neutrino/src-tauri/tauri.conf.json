{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Neutrino",
  "version": "0.1.0",
  "identifier": "com.phosphor.neutrino",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npx vite --config vite.config.js --port 5183 --strictPort",
    "beforeBuildCommand": "npx vite build --config vite.config.js"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Neutrino",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "externalBin": ["binaries/neutrino-sim"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
