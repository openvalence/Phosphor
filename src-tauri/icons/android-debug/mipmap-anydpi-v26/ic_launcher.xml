<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (app/src/debug/res): the Cyanotype mark, so a debug
     install reads apart from the release one. No monochrome layer on purpose:
     with themed icons on, the debug icon stays in color. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_debug_background"/>
  <foreground android:drawable="@drawable/ic_launcher_debug_foreground"/>
</adaptive-icon>
